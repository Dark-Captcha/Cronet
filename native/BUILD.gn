# Standalone Cronet: Chromium's network stack behind the C ABI in cronet.h.
#
# These sources live outside the Chromium tree and are copied in by
# scripts/build_native.sh, so they include their own headers by name rather
# than by path from the source root.
#
# Nothing in Chromium refers to this directory, and GN only loads build files
# it can reach from its root target, so this one is generated by pointing GN
# straight at it:
#
#   gn gen <dir> --root-target=//components/cronet/standalone:cronet
#
# That needs no edit anywhere in the Chromium tree, and it keeps the graph down
# to what the library actually links. It does not, however, get rid of the
# desktop dependencies: //components/metrics reaches the UI graph, so GLib and
# NSS remain hard DT_NEEDED entries. Only D-Bus is dropped.
shared_library("cronet") {
  sources = [
    "c_api.cc",
    "call.cc",
    "call.h",
    "cronet.h",
    "engine.cc",
    "engine.h",
    "global_state.cc",
    "global_state.h",
  ]

  deps = [
    "//base",
    "//components/cronet:cronet_common",
    "//components/cronet:cronet_version_header",
    "//net",
    "//url",
  ]

  # Export the 17 cronet_* entry points and nothing else. See cronet.map for
  # what leaks without it.
  inputs = [ "cronet.map" ]
  ldflags = [ "-Wl,--version-script=" +
              rebase_path("cronet.map", root_build_dir) ]
}
