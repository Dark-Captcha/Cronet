+// Reads the list at |key| in |args| as TLS code points into |out|. Returns
+// false, leaving |out| untouched, if the list is present but any element is not
+// an integer that fits in a uint16_t. A missing list is not an error and leaves
+// |out| untouched.
+bool ParseTlsCodePointList(const base::DictValue& args,
+                           std::string_view key,
+                           std::vector<uint16_t>* out) {
+  const base::ListValue* list = args.FindList(key);
+  if (!list) {
+    return true;
+  }
+  std::vector<uint16_t> code_points;
+  code_points.reserve(list->size());
+  for (const base::Value& element : *list) {
+    std::optional<int> code_point = element.GetIfInt();
+    if (!code_point.has_value() || *code_point < 0 || *code_point > 0xffff) {
+      LOG(ERROR) << "\"" << kTlsProfileFieldTrialName << "\" member \"" << key
+                 << "\" contains \"" << element
+                 << "\", which is not a TLS code point";
+      return false;
+    }
+    code_points.push_back(static_cast<uint16_t>(*code_point));
+  }
+  *out = std::move(code_points);
+  return true;
+}
+
+// Reads the TLS version string at |key| in |args| into |out|. Returns false,
+// leaving |out| untouched, if the value is present but not a supported version.
+// A missing value is not an error and leaves |out| untouched.
+bool ParseTlsVersion(const base::DictValue& args,
+                     std::string_view key,
+                     std::optional<uint16_t>* out) {
+  const std::string* version = args.FindString(key);
+  if (!version) {
+    return true;
+  }
+  if (*version == "1.2") {
+    *out = net::SSL_PROTOCOL_VERSION_TLS1_2;
+  } else if (*version == "1.3") {
+    *out = net::SSL_PROTOCOL_VERSION_TLS1_3;
+  } else {
+    LOG(ERROR) << "\"" << kTlsProfileFieldTrialName << "\" member \"" << key
+               << "\" is \"" << *version << "\", which is not \"1.2\" or"
+               << " \"1.3\"";
+    return false;
+  }
+  return true;
+}
+
+// Reads the boolean at |key| in |args| into |out|. Returns false, leaving |out|
+// untouched, if the value is present but not a boolean. A missing value is not
+// an error and leaves |out| untouched.
+bool ParseTlsBool(const base::DictValue& args,
+                  std::string_view key,
+                  std::optional<bool>* out) {
+  const base::Value* value = args.Find(key);
+  if (!value) {
+    return true;
+  }
+  if (!value->is_bool()) {
+    LOG(ERROR) << "\"" << kTlsProfileFieldTrialName << "\" member \"" << key
+               << "\" is \"" << *value << "\", which is not a bool";
+    return false;
+  }
+  *out = value->GetBool();
+  return true;
+}
+
+// Reads |args| as a TLS ClientHello profile. Returns nullopt if any member is
+// malformed, so that a bad profile fails loudly rather than silently producing
+// a ClientHello the caller did not ask for.
+std::optional<net::TlsProfile> ParseTlsProfile(const base::DictValue& args) {
+  net::TlsProfile profile;
+  if (!ParseTlsCodePointList(args, kTlsProfileCipherSuites,
+                             &profile.cipher_suites) ||
+      !ParseTlsCodePointList(args, kTlsProfileExtensionOrder,
+                             &profile.extension_order) ||
+      !ParseTlsCodePointList(args, kTlsProfileSupportedGroups,
+                             &profile.supported_groups) ||
+      !ParseTlsCodePointList(args, kTlsProfileKeyShareGroups,
+                             &profile.key_share_groups) ||
+      !ParseTlsCodePointList(args, kTlsProfileSignatureAlgorithms,
+                             &profile.signature_algorithms) ||
+      !ParseTlsVersion(args, kTlsProfileMinVersion, &profile.min_version) ||
+      !ParseTlsVersion(args, kTlsProfileMaxVersion, &profile.max_version)) {
+    return std::nullopt;
+  }
+
+  // A real fingerprint may name an extension whose position is not BoringSSL's
+  // to choose, padding being the likely one. Report those and carry on with the
+  // rest, rather than failing every connection over an entry that would have
+  // been written anyway.
+  for (uint16_t extension_type : profile.RemoveUnorderableExtensions()) {
+    LOG(ERROR) << "\"" << kTlsProfileFieldTrialName << "\" member \""
+               << kTlsProfileExtensionOrder << "\" names extension "
+               << extension_type
+               << ", whose position BoringSSL does not control; ignoring it";
+  }
+
+  const base::ListValue* alpn = args.FindList(kTlsProfileAlpn);
+  if (alpn) {
+    for (const base::Value& element : *alpn) {
+      const std::string* proto_string = element.GetIfString();
+      net::NextProto proto = proto_string
+                                 ? net::NextProtoFromString(*proto_string)
+                                 : net::NextProto::kProtoUnknown;
+      if (proto == net::NextProto::kProtoUnknown) {
+        LOG(ERROR) << "\"" << kTlsProfileFieldTrialName << "\" member \""
+                   << kTlsProfileAlpn << "\" contains \"" << element
+                   << "\", which is not a known ALPN protocol";
+        return std::nullopt;
+      }
+      profile.alpn.push_back(proto);
+    }
+  }
+
+  if (!ParseTlsBool(args, kTlsProfileGrease, &profile.grease) ||
+      !ParseTlsBool(args, kTlsProfilePermuteExtensions,
+                    &profile.permute_extensions)) {
+    return std::nullopt;
+  }
+  return profile;
+}
