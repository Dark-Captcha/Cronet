+TlsProfile::TlsProfile() = default;
+TlsProfile::TlsProfile(const TlsProfile&) = default;
+TlsProfile::TlsProfile(TlsProfile&&) = default;
+TlsProfile::~TlsProfile() = default;
+TlsProfile& TlsProfile::operator=(const TlsProfile&) = default;
+TlsProfile& TlsProfile::operator=(TlsProfile&&) = default;
+bool TlsProfile::operator==(const TlsProfile&) const = default;
+
+std::vector<uint16_t> TlsProfile::RemoveUnorderableExtensions() {
+  std::vector<uint16_t> removed;
+  std::erase_if(extension_order, [&removed](uint16_t extension_type) {
+    if (SSL_extension_order_supported(extension_type)) {
+      return false;
+    }
+    removed.push_back(extension_type);
+    return true;
+  });
+  return removed;
+}
