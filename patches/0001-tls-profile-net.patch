+// An explicitly specified TLS ClientHello profile, used to reproduce a
+// particular handshake fingerprint instead of Chromium's own.
+//
+// Every member is optional: an empty list or an unset optional means "keep
+// Chromium's behaviour for this part of the ClientHello". A default-constructed
+// TlsProfile therefore changes nothing at all, and the bytes on the wire are
+// exactly what they would be without it.
+//
+// Numeric members are IANA code points in host byte order (e.g. 0x1301 for
+// TLS_AES_128_GCM_SHA256, 23 for secp256r1).
+struct NET_EXPORT TlsProfile {
+  TlsProfile();
+  TlsProfile(const TlsProfile&);
+  TlsProfile(TlsProfile&&);
+  ~TlsProfile();
+  TlsProfile& operator=(const TlsProfile&);
+  TlsProfile& operator=(TlsProfile&&);
+
+  bool operator==(const TlsProfile&) const;
+
+  // Removes from `extension_order` every extension whose position in the
+  // ClientHello BoringSSL does not control, such as padding, and returns the
+  // code points removed. Those extensions are still sent; only their position
+  // is not the caller's to choose. Code that builds a profile from user input
+  // should call this once, when the profile is built, so that an unorderable
+  // entry is reported there instead of failing every connection.
+  std::vector<uint16_t> RemoveUnorderableExtensions();
+
+  // Cipher suites to offer, in exactly this order. This controls only what is
+  // advertised; which suites may actually be negotiated is still decided by
+  // net's own cipher policy, so a suite listed here that net would not accept
+  // will fail the handshake if the server selects it.
+  std::vector<uint16_t> cipher_suites;
+
+  // TLS ExtensionType code points, in the order the extensions must appear in
+  // the ClientHello. Extensions that are omitted here are still sent, after the
+  // listed ones. Listing an extension does not cause it to be sent if it would
+  // not have been sent anyway. Every entry must be an extension BoringSSL
+  // implements, or the connection fails.
+  std::vector<uint16_t> extension_order;
+
+  // Named groups for the supported_groups extension, in order.
+  std::vector<uint16_t> supported_groups;
+
+  // Named groups to send key shares for, in order. Must be a subsequence of the
+  // supported groups. If empty while `supported_groups` is set, BoringSSL's
+  // default key share selection for that group list is used.
+  std::vector<uint16_t> key_share_groups;
+
+  // Signature algorithm code points for the signature_algorithms extension, in
+  // order.
+  std::vector<uint16_t> signature_algorithms;
+
+  // ALPN protocols to offer, in order, replacing the ones the session asked
+  // for.
+  NextProtoVector alpn;
+
+  // Minimum and maximum protocol versions, as SSL_PROTOCOL_VERSION_* values.
+  // These take precedence over both the per-socket overrides and the context
+  // configuration.
+  std::optional<uint16_t> min_version;
+  std::optional<uint16_t> max_version;
+
+  // Whether to send GREASE values (RFC 8701).
+  std::optional<bool> grease;
+
+  // Whether to randomly permute the ClientHello extensions. Ignored when
+  // `extension_order` is set, which always wins.
+  std::optional<bool> permute_extensions;
+};
