+// SSL_set1_client_cipher_suites, when called by a client before the handshake,
+// configures `ssl` to write exactly `cipher_suites`, in the order given, as the
+// cipher_suites field of the ClientHello, in place of the list computed from
+// the configured cipher list. A GREASE value, if enabled, is still prepended,
+// and the fallback SCSV, if enabled, is still appended. Setting an empty list
+// restores the default behavior. It returns one on success and zero on error.
+//
+// This only changes what is offered on the wire. Whether a cipher suite may
+// actually be negotiated is still determined by the configured cipher list (see
+// `SSL_set_cipher_list`) and protocol versions, so a suite listed here that the
+// connection would otherwise not accept will be rejected if the server selects
+// it. TLS 1.3 cipher suites are also written verbatim from this list, so it
+// must include them if TLS 1.3 is to be offered.
+OPENSSL_EXPORT int SSL_set1_client_cipher_suites(SSL *ssl,
+                                                 const uint16_t *cipher_suites,
+                                                 size_t num_cipher_suites);
+
+// SSL_set1_extension_order, when called by a client before the handshake,
+// configures `ssl` to write the ClientHello extensions named by
+// `extension_types` first, in the order given, followed by every other
+// extension BoringSSL implements, in its usual order. Each element is a TLS
+// ExtensionType code point and must be one BoringSSL implements and must not
+// repeat; otherwise this function returns zero and the order is unchanged.
+// Setting an empty list restores the default behavior. It returns one on
+// success and zero on error.
+//
+// An extension only appears in the ClientHello if it would have been sent
+// anyway; naming one here does not cause it to be sent. This overrides
+// `SSL_set_permute_extensions`.
+OPENSSL_EXPORT int SSL_set1_extension_order(SSL *ssl,
+                                            const uint16_t *extension_types,
+                                            size_t num_extension_types);
+
+// SSL_extension_order_supported returns one if `extension_type` may be named in
+// `SSL_set1_extension_order` and zero otherwise. Extensions that BoringSSL
+// writes outside the extension table, such as padding, are not orderable and
+// return zero.
+OPENSSL_EXPORT int SSL_extension_order_supported(uint16_t extension_type);
+
 // SSL_set1_server_supported_groups_hint, when `ssl` is a client, indicates that
 // the server is likely to support groups listed in `server_groups`, in order of
 // decreasing server preference. This function returns one on success and zero
@@ -5510,6 +5549,11 @@ OPENSSL_EXPORT void SSL_CTX_set_retain_only_sha256_of_client_certs(SSL_CTX *ctx,
 // GREASE. See RFC 8701.
 OPENSSL_EXPORT void SSL_CTX_set_grease_enabled(SSL_CTX *ctx, int enabled);
 
+// SSL_set_grease_enabled configures whether `ssl` should enable GREASE,
+// overriding the setting from its |SSL_CTX| for this connection only. See RFC
+// 8701.
+OPENSSL_EXPORT void SSL_set_grease_enabled(SSL *ssl, int enabled);
+
 // SSL_CTX_set_permute_extensions configures whether sockets on `ctx` should
 // permute extensions. For now, this is only implemented for the ClientHello.
 OPENSSL_EXPORT void SSL_CTX_set_permute_extensions(SSL_CTX *ctx, int enabled);
