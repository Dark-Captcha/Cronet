+int SSL_extension_order_supported(uint16_t extension_type) {
+  uint32_t index;
+  return tls_extension_find(&index, extension_type) != nullptr;
+}
+
+int SSL_set1_extension_order(SSL *ssl, const uint16_t *extension_types,
+                             size_t num_extension_types) {
+  if (ssl->config == nullptr) {
+    return 0;
+  }
+
+  if (num_extension_types == 0) {
+    ssl->config->extension_order.Reset();
+    return 1;
+  }
+
+  Array<uint8_t> order;
+  if (!order.InitForOverwrite(kNumExtensions)) {
+    return 0;
+  }
+
+  // Place the extensions the caller named first, in the order given, then the
+  // rest in table order so that nothing the caller did not mention is dropped.
+  std::bitset<kNumExtensions> placed;
+  size_t len = 0;
+  for (uint16_t extension_type : Span(extension_types, num_extension_types)) {
+    uint32_t index;
+    if (tls_extension_find(&index, extension_type) == nullptr) {
+      // The extension is not implemented, so it can never be written.
+      OPENSSL_PUT_ERROR(SSL, SSL_R_ERROR_ADDING_EXTENSION);
+      ERR_add_error_dataf("extension %u", (unsigned)extension_type);
+      return 0;
+    }
+    if (placed[index]) {
+      OPENSSL_PUT_ERROR(SSL, SSL_R_DUPLICATE_EXTENSION);
+      ERR_add_error_dataf("extension %u", (unsigned)extension_type);
+      return 0;
+    }
+    placed[index] = true;
+    order[len++] = (uint8_t)index;
+  }
+  for (size_t i = 0; i < kNumExtensions; i++) {
+    if (!placed[i]) {
+      order[len++] = (uint8_t)i;
+    }
+  }
+  assert(len == kNumExtensions);
+
+  ssl->config->extension_order = std::move(order);
+  return 1;
+}
