new file mode 100644
index 0000000000000..ca555d263fa11
--- /dev/null
+++ b/net/socket/socks5_udp_client_socket.cc
@@ -0,0 +1,728 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "net/socket/socks5_udp_client_socket.h"
+
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/numerics/byte_conversions.h"
+#include "base/numerics/safe_conversions.h"
+#include "net/base/address_list.h"
+#include "net/base/io_buffer.h"
+#include "net/base/ip_address.h"
+#include "net/base/net_errors.h"
+#include "net/base/proxy_chain.h"
+#include "net/socket/client_socket_factory.h"
+#include "net/socket/stream_socket.h"
+
+namespace net {
+
+namespace {
+
+constexpr uint8_t kSOCKS5Version = 0x05;
+constexpr uint8_t kAuthMethodNone = 0x00;
+constexpr uint8_t kAuthMethodUsernamePassword = 0x02;
+constexpr uint8_t kAuthSubnegotiationVersion = 0x01;
+constexpr uint8_t kUdpAssociateCommand = 0x03;
+constexpr uint8_t kAddressTypeIPv4 = 0x01;
+constexpr uint8_t kAddressTypeDomain = 0x03;
+constexpr uint8_t kAddressTypeIPv6 = 0x04;
+
+// Version, method.
+constexpr int kGreetReplySize = 2;
+// Version, status.
+constexpr int kAuthReplySize = 2;
+// Version, reply, reserved, address type. The address and port follow, and
+// their length depends on the address type.
+constexpr int kReplyPrefixSize = 4;
+
+// RFC 1928 section 7: two reserved bytes, a fragment byte, an address type,
+// the address, then the port.
+constexpr size_t kUdpHeaderSizeIPv4 = 2 + 1 + 1 + 4 + 2;
+constexpr size_t kUdpHeaderSizeIPv6 = 2 + 1 + 1 + 16 + 2;
+
+size_t UdpHeaderSize(const IPEndPoint& endpoint) {
+  return endpoint.address().IsIPv4() ? kUdpHeaderSizeIPv4 : kUdpHeaderSizeIPv6;
+}
+
+// Writes the RFC 1928 section 7 request header naming |destination|.
+void WriteUdpHeader(const IPEndPoint& destination, base::span<uint8_t> out) {
+  out[0] = 0x00;
+  out[1] = 0x00;
+  out[2] = 0x00;  // FRAG: this implementation never fragments.
+  const bool is_ipv4 = destination.address().IsIPv4();
+  out[3] = is_ipv4 ? kAddressTypeIPv4 : kAddressTypeIPv6;
+  const auto& bytes = destination.address().bytes();
+  out.subspan(4u, bytes.size()).copy_from(bytes);
+  auto port = base::U16ToBigEndian(destination.port());
+  out.subspan(4u + bytes.size(), port.size()).copy_from(port);
+}
+
+// The offset at which a relayed datagram's payload begins, or 0 if the header
+// is malformed.
+size_t UdpPayloadOffset(base::span<const uint8_t> datagram) {
+  if (datagram.size() < 4) {
+    return 0;
+  }
+  switch (datagram[3]) {
+    case kAddressTypeIPv4:
+      return datagram.size() >= kUdpHeaderSizeIPv4 ? kUdpHeaderSizeIPv4 : 0;
+    case kAddressTypeIPv6:
+      return datagram.size() >= kUdpHeaderSizeIPv6 ? kUdpHeaderSizeIPv6 : 0;
+    case kAddressTypeDomain: {
+      const size_t length = 5u + datagram[4] + 2u;
+      return datagram.size() >= length ? length : 0;
+    }
+    default:
+      return 0;
+  }
+}
+
+}  // namespace
+
+bool IsSocks5UdpProxyChain(const ProxyChain& proxy_chain) {
+  // An association is between one client and one proxy, so a chain of more
+  // than one hop cannot carry it.
+  return !proxy_chain.is_direct() && proxy_chain.length() == 1u &&
+         proxy_chain.Last().scheme() == ProxyServer::SCHEME_SOCKS5;
+}
+
+SOCKS5UDPClientSocket::SOCKS5UDPClientSocket(
+    std::unique_ptr<DatagramClientSocket> udp_socket,
+    ClientSocketFactory* client_socket_factory,
+    HostResolver* host_resolver,
+    const HostPortPair& proxy,
+    std::string username,
+    std::string password,
+    const NetworkTrafficAnnotationTag& traffic_annotation,
+    NetLogWithSource net_log)
+    : udp_socket_(std::move(udp_socket)),
+      client_socket_factory_(client_socket_factory),
+      host_resolver_(host_resolver),
+      proxy_(proxy),
+      username_(std::move(username)),
+      password_(std::move(password)),
+      traffic_annotation_(traffic_annotation),
+      net_log_(std::move(net_log)) {}
+
+SOCKS5UDPClientSocket::~SOCKS5UDPClientSocket() {
+  Close();
+}
+
+int SOCKS5UDPClientSocket::Connect(const IPEndPoint& address) {
+  // The association needs several round trips, so there is no synchronous
+  // path. Callers reach this socket through ConnectAsync.
+  return ERR_NOT_IMPLEMENTED;
+}
+
+int SOCKS5UDPClientSocket::ConnectUsingNetwork(handles::NetworkHandle network,
+                                               const IPEndPoint& address) {
+  return ERR_NOT_IMPLEMENTED;
+}
+
+int SOCKS5UDPClientSocket::ConnectUsingDefaultNetwork(
+    const IPEndPoint& address) {
+  return ERR_NOT_IMPLEMENTED;
+}
+
+int SOCKS5UDPClientSocket::ConnectAsync(const IPEndPoint& address,
+                                        CompletionOnceCallback callback) {
+  DCHECK_EQ(STATE_NONE, next_state_);
+  destination_ = address;
+  next_state_ = STATE_RESOLVE_PROXY;
+  int rv = DoLoop(OK);
+  if (rv == ERR_IO_PENDING) {
+    user_callback_ = std::move(callback);
+  }
+  return rv;
+}
+
+int SOCKS5UDPClientSocket::ConnectUsingNetworkAsync(
+    handles::NetworkHandle network,
+    const IPEndPoint& address,
+    CompletionOnceCallback callback) {
+  // Binding the association to one network would have to bind both sockets,
+  // and the control connection's network is the proxy's business.
+  return ConnectAsync(address, std::move(callback));
+}
+
+int SOCKS5UDPClientSocket::ConnectUsingDefaultNetworkAsync(
+    const IPEndPoint& address,
+    CompletionOnceCallback callback) {
+  return ConnectAsync(address, std::move(callback));
+}
+
+void SOCKS5UDPClientSocket::DoCallback(int result) {
+  DCHECK_NE(ERR_IO_PENDING, result);
+  if (!user_callback_.is_null()) {
+    std::move(user_callback_).Run(result);
+  }
+}
+
+void SOCKS5UDPClientSocket::OnIOComplete(int result) {
+  int rv = DoLoop(result);
+  if (rv != ERR_IO_PENDING) {
+    DoCallback(rv);
+  }
+}
+
+int SOCKS5UDPClientSocket::DoLoop(int last_io_result) {
+  DCHECK_NE(next_state_, STATE_NONE);
+  int rv = last_io_result;
+  do {
+    State state = next_state_;
+    next_state_ = STATE_NONE;
+    switch (state) {
+      case STATE_RESOLVE_PROXY:
+        rv = DoResolveProxy();
+        break;
+      case STATE_RESOLVE_PROXY_COMPLETE:
+        rv = DoResolveProxyComplete(rv);
+        break;
+      case STATE_TCP_CONNECT:
+        rv = DoTcpConnect();
+        break;
+      case STATE_TCP_CONNECT_COMPLETE:
+        rv = DoTcpConnectComplete(rv);
+        break;
+      case STATE_GREET_WRITE:
+        rv = DoGreetWrite();
+        break;
+      case STATE_GREET_WRITE_COMPLETE:
+        rv = DoGreetWriteComplete(rv);
+        break;
+      case STATE_GREET_READ:
+        rv = DoGreetRead();
+        break;
+      case STATE_GREET_READ_COMPLETE:
+        rv = DoGreetReadComplete(rv);
+        break;
+      case STATE_AUTH_WRITE:
+        rv = DoAuthWrite();
+        break;
+      case STATE_AUTH_WRITE_COMPLETE:
+        rv = DoAuthWriteComplete(rv);
+        break;
+      case STATE_AUTH_READ:
+        rv = DoAuthRead();
+        break;
+      case STATE_AUTH_READ_COMPLETE:
+        rv = DoAuthReadComplete(rv);
+        break;
+      case STATE_ASSOCIATE_WRITE:
+        rv = DoAssociateWrite();
+        break;
+      case STATE_ASSOCIATE_WRITE_COMPLETE:
+        rv = DoAssociateWriteComplete(rv);
+        break;
+      case STATE_ASSOCIATE_READ:
+        rv = DoAssociateRead();
+        break;
+      case STATE_ASSOCIATE_READ_COMPLETE:
+        rv = DoAssociateReadComplete(rv);
+        break;
+      case STATE_UDP_CONNECT:
+        rv = DoUdpConnect();
+        break;
+      default:
+        NOTREACHED() << "bad state";
+    }
+  } while (rv != ERR_IO_PENDING && next_state_ != STATE_NONE);
+  return rv;
+}
+
+int SOCKS5UDPClientSocket::DoResolveProxy() {
+  next_state_ = STATE_RESOLVE_PROXY_COMPLETE;
+
+  // A numeric proxy needs no resolver, and configurations that name one by
+  // address are common enough to be worth the short cut.
+  IPAddress literal;
+  if (literal.AssignFromIPLiteral(proxy_.host())) {
+    proxy_addresses_ = AddressList(IPEndPoint(literal, proxy_.port()));
+    return OK;
+  }
+
+  HostResolver::ResolveHostParameters parameters;
+  parameters.initial_priority = MEDIUM;
+  resolve_request_ = host_resolver_->CreateRequest(
+      HostPortPair(proxy_.host(), proxy_.port()), NetworkAnonymizationKey(),
+      net_log_, parameters);
+  return resolve_request_->Start(base::BindOnce(
+      &SOCKS5UDPClientSocket::OnIOComplete, weak_factory_.GetWeakPtr()));
+}
+
+int SOCKS5UDPClientSocket::DoResolveProxyComplete(int result) {
+  if (result != OK) {
+    return result;
+  }
+  if (resolve_request_) {
+    const AddressList& resolved = resolve_request_->GetAddressResults();
+    if (resolved.empty()) {
+      return ERR_NAME_NOT_RESOLVED;
+    }
+    proxy_addresses_ = resolved;
+    resolve_request_.reset();
+  }
+  next_state_ = STATE_TCP_CONNECT;
+  return OK;
+}
+
+int SOCKS5UDPClientSocket::DoTcpConnect() {
+  next_state_ = STATE_TCP_CONNECT_COMPLETE;
+  control_socket_ = client_socket_factory_->CreateTransportClientSocket(
+      proxy_addresses_, nullptr, nullptr, net_log_.net_log(),
+      net_log_.source());
+  return control_socket_->Connect(base::BindOnce(
+      &SOCKS5UDPClientSocket::OnIOComplete, weak_factory_.GetWeakPtr()));
+}
+
+int SOCKS5UDPClientSocket::DoTcpConnectComplete(int result) {
+  if (result != OK) {
+    return result;
+  }
+  next_state_ = STATE_GREET_WRITE;
+  return OK;
+}
+
+int SOCKS5UDPClientSocket::DoGreetWrite() {
+  next_state_ = STATE_GREET_WRITE_COMPLETE;
+  if (!write_buf_) {
+    std::vector<uint8_t> greeting;
+    if (has_credentials()) {
+      greeting = {kSOCKS5Version, 0x02, kAuthMethodNone,
+                  kAuthMethodUsernamePassword};
+    } else {
+      greeting = {kSOCKS5Version, 0x01, kAuthMethodNone};
+    }
+    auto buffer = base::MakeRefCounted<VectorIOBuffer>(std::move(greeting));
+    write_buf_ = base::MakeRefCounted<DrainableIOBuffer>(std::move(buffer),
+                                                         buffer->size());
+  }
+  return control_socket_->Write(
+      write_buf_.get(), write_buf_->BytesRemaining(),
+      base::BindOnce(&SOCKS5UDPClientSocket::OnIOComplete,
+                     weak_factory_.GetWeakPtr()),
+      traffic_annotation_);
+}
+
+int SOCKS5UDPClientSocket::DoGreetWriteComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  write_buf_->DidConsume(result);
+  if (write_buf_->BytesRemaining() == 0) {
+    write_buf_.reset();
+    next_state_ = STATE_GREET_READ;
+  } else {
+    next_state_ = STATE_GREET_WRITE;
+  }
+  return OK;
+}
+
+int SOCKS5UDPClientSocket::DoGreetRead() {
+  next_state_ = STATE_GREET_READ_COMPLETE;
+  if (!read_buf_) {
+    read_buf_ = base::MakeRefCounted<GrowableIOBuffer>();
+    read_buf_->SetCapacity(kGreetReplySize);
+  }
+  return control_socket_->Read(
+      read_buf_.get(), read_buf_->RemainingCapacity(),
+      base::BindOnce(&SOCKS5UDPClientSocket::OnIOComplete,
+                     weak_factory_.GetWeakPtr()));
+}
+
+int SOCKS5UDPClientSocket::DoGreetReadComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  if (result == 0) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  read_buf_->set_offset(read_buf_->offset() + result);
+  if (read_buf_->RemainingCapacity() > 0) {
+    next_state_ = STATE_GREET_READ;
+    return OK;
+  }
+  base::span<uint8_t> reply = read_buf_->span_before_offset();
+  if (reply[0] != kSOCKS5Version) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  const uint8_t method = reply[1];
+  read_buf_.reset();
+  if (method == kAuthMethodUsernamePassword && has_credentials()) {
+    next_state_ = STATE_AUTH_WRITE;
+    return OK;
+  }
+  if (method != kAuthMethodNone) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  next_state_ = STATE_ASSOCIATE_WRITE;
+  return OK;
+}
+
+int SOCKS5UDPClientSocket::DoAuthWrite() {
+  next_state_ = STATE_AUTH_WRITE_COMPLETE;
+  if (!write_buf_) {
+    std::vector<uint8_t> request;
+    request.reserve(3 + username_.size() + password_.size());
+    request.push_back(kAuthSubnegotiationVersion);
+    request.push_back(base::checked_cast<uint8_t>(username_.size()));
+    request.insert(request.end(), username_.begin(), username_.end());
+    request.push_back(base::checked_cast<uint8_t>(password_.size()));
+    request.insert(request.end(), password_.begin(), password_.end());
+    auto buffer = base::MakeRefCounted<VectorIOBuffer>(std::move(request));
+    write_buf_ = base::MakeRefCounted<DrainableIOBuffer>(std::move(buffer),
+                                                         buffer->size());
+  }
+  return control_socket_->Write(
+      write_buf_.get(), write_buf_->BytesRemaining(),
+      base::BindOnce(&SOCKS5UDPClientSocket::OnIOComplete,
+                     weak_factory_.GetWeakPtr()),
+      traffic_annotation_);
+}
+
+int SOCKS5UDPClientSocket::DoAuthWriteComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  write_buf_->DidConsume(result);
+  if (write_buf_->BytesRemaining() == 0) {
+    write_buf_.reset();
+    next_state_ = STATE_AUTH_READ;
+  } else {
+    next_state_ = STATE_AUTH_WRITE;
+  }
+  return OK;
+}
+
+int SOCKS5UDPClientSocket::DoAuthRead() {
+  next_state_ = STATE_AUTH_READ_COMPLETE;
+  if (!read_buf_) {
+    read_buf_ = base::MakeRefCounted<GrowableIOBuffer>();
+    read_buf_->SetCapacity(kAuthReplySize);
+  }
+  return control_socket_->Read(
+      read_buf_.get(), read_buf_->RemainingCapacity(),
+      base::BindOnce(&SOCKS5UDPClientSocket::OnIOComplete,
+                     weak_factory_.GetWeakPtr()));
+}
+
+int SOCKS5UDPClientSocket::DoAuthReadComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  if (result == 0) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  read_buf_->set_offset(read_buf_->offset() + result);
+  if (read_buf_->RemainingCapacity() > 0) {
+    next_state_ = STATE_AUTH_READ;
+    return OK;
+  }
+  base::span<uint8_t> reply = read_buf_->span_before_offset();
+  read_buf_.reset();
+  if (reply[0] != kAuthSubnegotiationVersion) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  if (reply[1] != 0x00) {
+    return ERR_PROXY_AUTH_UNSUPPORTED;
+  }
+  next_state_ = STATE_ASSOCIATE_WRITE;
+  return OK;
+}
+
+int SOCKS5UDPClientSocket::DoAssociateWrite() {
+  next_state_ = STATE_ASSOCIATE_WRITE_COMPLETE;
+  if (!write_buf_) {
+    // All-zero address and port: the client does not know in advance which
+    // local endpoint it will send from, which is the usual case and what the
+    // RFC provides for.
+    std::vector<uint8_t> request = {kSOCKS5Version, kUdpAssociateCommand, 0x00,
+                                    kAddressTypeIPv4, 0,    0,    0,    0,
+                                    0,                0};
+    auto buffer = base::MakeRefCounted<VectorIOBuffer>(std::move(request));
+    write_buf_ = base::MakeRefCounted<DrainableIOBuffer>(std::move(buffer),
+                                                         buffer->size());
+  }
+  return control_socket_->Write(
+      write_buf_.get(), write_buf_->BytesRemaining(),
+      base::BindOnce(&SOCKS5UDPClientSocket::OnIOComplete,
+                     weak_factory_.GetWeakPtr()),
+      traffic_annotation_);
+}
+
+int SOCKS5UDPClientSocket::DoAssociateWriteComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  write_buf_->DidConsume(result);
+  if (write_buf_->BytesRemaining() == 0) {
+    write_buf_.reset();
+    next_state_ = STATE_ASSOCIATE_READ;
+    associate_reply_remaining_ = 0;
+  } else {
+    next_state_ = STATE_ASSOCIATE_WRITE;
+  }
+  return OK;
+}
+
+int SOCKS5UDPClientSocket::DoAssociateRead() {
+  next_state_ = STATE_ASSOCIATE_READ_COMPLETE;
+  if (!read_buf_) {
+    read_buf_ = base::MakeRefCounted<GrowableIOBuffer>();
+    read_buf_->SetCapacity(kReplyPrefixSize);
+  }
+  return control_socket_->Read(
+      read_buf_.get(), read_buf_->RemainingCapacity(),
+      base::BindOnce(&SOCKS5UDPClientSocket::OnIOComplete,
+                     weak_factory_.GetWeakPtr()));
+}
+
+int SOCKS5UDPClientSocket::DoAssociateReadComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  if (result == 0) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  read_buf_->set_offset(read_buf_->offset() + result);
+  if (read_buf_->RemainingCapacity() > 0) {
+    next_state_ = STATE_ASSOCIATE_READ;
+    return OK;
+  }
+
+  base::span<uint8_t> reply = read_buf_->span_before_offset();
+  if (associate_reply_remaining_ == 0) {
+    // The fixed prefix has arrived; work out how much address follows.
+    if (reply[0] != kSOCKS5Version) {
+      return ERR_SOCKS_CONNECTION_FAILED;
+    }
+    if (reply[1] != 0x00) {
+      // The proxy declined to relay UDP. 0x07 is "command not supported",
+      // which is what a proxy without UDP support answers.
+      return ERR_SOCKS_CONNECTION_FAILED;
+    }
+    switch (reply[3]) {
+      case kAddressTypeIPv4:
+        associate_reply_remaining_ = 4 + 2;
+        break;
+      case kAddressTypeIPv6:
+        associate_reply_remaining_ = 16 + 2;
+        break;
+      default:
+        // A named relay would need resolving, which the proxy should not ask
+        // of a client it just told where to send.
+        return ERR_SOCKS_CONNECTION_FAILED;
+    }
+    read_buf_->SetCapacity(kReplyPrefixSize +
+                           base::checked_cast<int>(associate_reply_remaining_));
+    next_state_ = STATE_ASSOCIATE_READ;
+    return OK;
+  }
+
+  // The whole reply is in hand.
+  const uint8_t address_type = reply[3];
+  base::span<uint8_t> rest = reply.subspan(static_cast<size_t>(kReplyPrefixSize));
+  IPAddress relay_address;
+  size_t address_length = 0;
+  if (address_type == kAddressTypeIPv4) {
+    address_length = 4;
+    relay_address = IPAddress(rest.first(4u));
+  } else {
+    address_length = 16;
+    relay_address = IPAddress(rest.first(16u));
+  }
+  const uint16_t port =
+      base::U16FromBigEndian(rest.subspan(address_length).first<2>());
+
+  // A proxy that answers with an unspecified address means "the one you are
+  // already talking to", which is the address of the control connection.
+  if (relay_address.IsZero()) {
+    IPEndPoint peer;
+    int rv = control_socket_->GetPeerAddress(&peer);
+    if (rv != OK) {
+      return rv;
+    }
+    relay_address = peer.address();
+  }
+  relay_ = IPEndPoint(relay_address, port);
+  read_buf_.reset();
+  next_state_ = STATE_UDP_CONNECT;
+  return OK;
+}
+
+int SOCKS5UDPClientSocket::DoUdpConnect() {
+  // Connected to the relay, not to the destination: every datagram names the
+  // destination in its own header instead.
+  return udp_socket_->Connect(relay_);
+}
+
+int SOCKS5UDPClientSocket::Write(
+    IOBuffer* buf,
+    int buf_len,
+    CompletionOnceCallback callback,
+    const NetworkTrafficAnnotationTag& traffic_annotation) {
+  const size_t header_size = UdpHeaderSize(destination_);
+  auto wrapped = base::MakeRefCounted<IOBufferWithSize>(
+      base::checked_cast<int>(header_size) + buf_len);
+  WriteUdpHeader(destination_, wrapped->span());
+  wrapped->span().subspan(header_size).copy_from(
+      buf->span().first(base::checked_cast<size_t>(buf_len)));
+
+  // The caller counts the payload it handed over, not the bytes on the wire,
+  // so the header is subtracted from the result. A datagram write is
+  // all-or-nothing, so anything shorter than the whole thing is a failure
+  // rather than a partial success — reporting it as a byte count would hand
+  // back a negative number, which the caller would read as an error code.
+  const auto to_payload_length = [](int result, size_t header_size) -> int {
+    if (result < 0) {
+      return result;
+    }
+    if (result < base::checked_cast<int>(header_size)) {
+      return ERR_FAILED;
+    }
+    return result - base::checked_cast<int>(header_size);
+  };
+
+  int rv = udp_socket_->Write(
+      wrapped.get(), wrapped->size(),
+      base::BindOnce(
+          // `wrapped` rides along only to stay alive until the write lands.
+          [](scoped_refptr<IOBuffer> wrapped, size_t header_size,
+             decltype(to_payload_length) to_payload_length,
+             CompletionOnceCallback callback, int result) {
+            std::move(callback).Run(to_payload_length(result, header_size));
+          },
+          wrapped, header_size, to_payload_length, std::move(callback)),
+      traffic_annotation);
+  return rv == ERR_IO_PENDING ? rv : to_payload_length(rv, header_size);
+}
+
+int SOCKS5UDPClientSocket::Read(IOBuffer* buf,
+                                int buf_len,
+                                CompletionOnceCallback callback) {
+  // A relayed datagram is the caller's payload behind a header, so the read
+  // lands in a buffer of its own and is copied across once the header has been
+  // measured. The largest header RFC 1928 defines is the IPv6 one, so that is
+  // what the extra room allows for.
+  //
+  // Both buffers travel with the completion rather than living on the object:
+  // two reads in flight at once would otherwise share one pair of members, and
+  // the first to complete would unwrap into the second's buffer.
+  const int wrapped_len =
+      buf_len + base::checked_cast<int>(kUdpHeaderSizeIPv6);
+  auto wrapped = base::MakeRefCounted<IOBufferWithSize>(wrapped_len);
+  scoped_refptr<IOBuffer> user_buf(buf);
+
+  const auto unwrap = [](const scoped_refptr<IOBuffer>& wrapped,
+                         const scoped_refptr<IOBuffer>& user_buf,
+                         int user_buf_len, int result) -> int {
+    if (result <= 0) {
+      return result;
+    }
+    base::span<const uint8_t> datagram =
+        wrapped->span().first(base::checked_cast<size_t>(result));
+    const size_t offset = UdpPayloadOffset(datagram);
+    if (offset == 0) {
+      // A datagram the proxy sent that this cannot parse. Dropping it silently
+      // would look like a stalled connection, so it is reported.
+      return ERR_SOCKS_CONNECTION_FAILED;
+    }
+    base::span<const uint8_t> payload = datagram.subspan(offset);
+    if (payload.size() > base::checked_cast<size_t>(user_buf_len)) {
+      return ERR_MSG_TOO_BIG;
+    }
+    user_buf->span().first(payload.size()).copy_from(payload);
+    return base::checked_cast<int>(payload.size());
+  };
+
+  int rv = udp_socket_->Read(
+      wrapped.get(), wrapped_len,
+      base::BindOnce(
+          [](scoped_refptr<IOBuffer> wrapped, scoped_refptr<IOBuffer> user_buf,
+             int user_buf_len, decltype(unwrap) unwrap,
+             CompletionOnceCallback callback, int result) {
+            std::move(callback).Run(
+                unwrap(wrapped, user_buf, user_buf_len, result));
+          },
+          wrapped, user_buf, buf_len, unwrap, std::move(callback)));
+  if (rv == ERR_IO_PENDING) {
+    return rv;
+  }
+  return unwrap(wrapped, user_buf, buf_len, rv);
+}
+
+void SOCKS5UDPClientSocket::Close() {
+  if (control_socket_) {
+    control_socket_->Disconnect();
+    control_socket_.reset();
+  }
+  udp_socket_->Close();
+}
+
+int SOCKS5UDPClientSocket::GetPeerAddress(IPEndPoint* address) const {
+  // The layer above asked for the destination it named, not for the relay.
+  *address = destination_;
+  return OK;
+}
