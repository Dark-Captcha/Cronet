+#include "net/traffic_annotation/network_traffic_annotation.h"
+
+namespace net {
+
+class ClientSocketFactory;
+class DrainableIOBuffer;
+class GrowableIOBuffer;
+class IOBuffer;
+class ProxyChain;
+class StreamSocket;
+
+// Whether |proxy_chain| can carry QUIC through a SOCKS5 UDP association.
+//
+// Defined here so that the decision has one home: the QUIC session pool asks
+// it to decide whether to wrap its socket, and the stream factory asks it to
+// decide whether a QUIC job is worth starting at all. Two copies of that rule
+// would eventually disagree, and the failure would be a silent fallback to
+// HTTP/2 rather than anything that announces itself.
+NET_EXPORT_PRIVATE bool IsSocks5UdpProxyChain(const ProxyChain& proxy_chain);
+
+// Relays datagrams through a SOCKS5 proxy using the UDP ASSOCIATE command of
+// RFC 1928, so that QUIC — and therefore HTTP/3 — can traverse a SOCKS5 proxy.
+//
+// The association is two sockets working together. A TCP control connection
+// performs the greeting, the optional RFC 1929 authentication and the
+// UDP ASSOCIATE request, and the proxy answers with the address of a relay.
+// Datagrams then travel over a separate UDP socket to that relay, each one
+// carrying the request header of RFC 1928 section 7 naming the real
+// destination. The control connection is held open for the lifetime of the
+// association, because a proxy tears the relay down when it closes.
+//
+// To the layer above this is an ordinary DatagramClientSocket connected to the
+// destination: the encapsulation is added on write and removed on read, so
+// QUIC neither knows nor needs to know that a proxy is in the path.
+class NET_EXPORT_PRIVATE SOCKS5UDPClientSocket : public DatagramClientSocket {
+ public:
+  // |udp_socket| carries the datagrams and must not be connected yet.
+  // |proxy| is the SOCKS5 proxy, and |username| and |password| are its RFC 1929
+  // credentials, empty when it needs none.
+  SOCKS5UDPClientSocket(std::unique_ptr<DatagramClientSocket> udp_socket,
+                        ClientSocketFactory* client_socket_factory,
+                        HostResolver* host_resolver,
+                        const HostPortPair& proxy,
+                        std::string username,
+                        std::string password,
+                        const NetworkTrafficAnnotationTag& traffic_annotation,
+                        NetLogWithSource net_log);
+
+  SOCKS5UDPClientSocket(const SOCKS5UDPClientSocket&) = delete;
+  SOCKS5UDPClientSocket& operator=(const SOCKS5UDPClientSocket&) = delete;
+
+  ~SOCKS5UDPClientSocket() override;
+
+  // DatagramClientSocket implementation. Only the asynchronous Connect forms
+  // are supported: the association needs several round trips with the proxy,
+  // which cannot be completed inside a synchronous call.
+  int Connect(const IPEndPoint& address) override;
+  int ConnectUsingNetwork(handles::NetworkHandle network,
+                          const IPEndPoint& address) override;
+  int ConnectUsingDefaultNetwork(const IPEndPoint& address) override;
+  int ConnectAsync(const IPEndPoint& address,
+                   CompletionOnceCallback callback) override;
+  int ConnectUsingNetworkAsync(handles::NetworkHandle network,
+                               const IPEndPoint& address,
+                               CompletionOnceCallback callback) override;
+  int ConnectUsingDefaultNetworkAsync(const IPEndPoint& address,
+                                      CompletionOnceCallback callback) override;
+
+  handles::NetworkHandle GetBoundNetwork() const override;
+  void ApplySocketTag(const SocketTag& tag) override;
+  int SetMulticastInterface(uint32_t interface_index) override;
+  void EnableRecvOptimization() override;
+
+  // Socket implementation.
+  int Read(IOBuffer* buf,
+           int buf_len,
+           CompletionOnceCallback callback) override;
+  int Write(IOBuffer* buf,
+            int buf_len,
+            CompletionOnceCallback callback,
+            const NetworkTrafficAnnotationTag& traffic_annotation) override;
+  int SetReceiveBufferSize(int32_t size) override;
+  int SetSendBufferSize(int32_t size) override;
+
+  // DatagramSocket implementation.
+  void Close() override;
+  int GetPeerAddress(IPEndPoint* address) const override;
+  int GetLocalAddress(IPEndPoint* address) const override;
+  void UseNonBlockingIO() override;
+  int SetDoNotFragment() override;
+  int SetRecvTos() override;
+  int SetTos(DiffServCodePoint dscp, EcnCodePoint ecn) override;
+  void SetMsgConfirm(bool confirm) override;
+  const NetLogWithSource& NetLog() const override;
+  DscpAndEcn GetLastTos() const override;
+
+ private:
+  enum State {
+    STATE_RESOLVE_PROXY,
+    STATE_RESOLVE_PROXY_COMPLETE,
+    STATE_TCP_CONNECT,
+    STATE_TCP_CONNECT_COMPLETE,
+    STATE_GREET_WRITE,
+    STATE_GREET_WRITE_COMPLETE,
+    STATE_GREET_READ,
+    STATE_GREET_READ_COMPLETE,
+    STATE_AUTH_WRITE,
+    STATE_AUTH_WRITE_COMPLETE,
+    STATE_AUTH_READ,
+    STATE_AUTH_READ_COMPLETE,
+    STATE_ASSOCIATE_WRITE,
+    STATE_ASSOCIATE_WRITE_COMPLETE,
+    STATE_ASSOCIATE_READ,
+    STATE_ASSOCIATE_READ_COMPLETE,
+    STATE_UDP_CONNECT,
+    STATE_NONE,
+  };
+
+  void DoCallback(int result);
+  void OnIOComplete(int result);
+  int DoLoop(int last_io_result);
+
+  int DoResolveProxy();
+  int DoResolveProxyComplete(int result);
+  int DoTcpConnect();
+  int DoTcpConnectComplete(int result);
+  int DoGreetWrite();
+  int DoGreetWriteComplete(int result);
+  int DoGreetRead();
+  int DoGreetReadComplete(int result);
+  int DoAuthWrite();
+  int DoAuthWriteComplete(int result);
+  int DoAuthRead();
+  int DoAuthReadComplete(int result);
+  int DoAssociateWrite();
+  int DoAssociateWriteComplete(int result);
+  int DoAssociateRead();
+  int DoAssociateReadComplete(int result);
+  int DoUdpConnect();
+
+  bool has_credentials() const { return !username_.empty(); }
+
+  // The datagram path, connected to the proxy's relay rather than to
+  // |destination_|.
+  const std::unique_ptr<DatagramClientSocket> udp_socket_;
+  // The control connection, held open so the proxy keeps the association.
+  std::unique_ptr<StreamSocket> control_socket_;
+  const raw_ptr<ClientSocketFactory> client_socket_factory_;
+  // The proxy is named rather than numeric in almost every configuration, so
+  // it is resolved here before the control connection is made.
+  const raw_ptr<HostResolver> host_resolver_;
+  std::unique_ptr<HostResolver::ResolveHostRequest> resolve_request_;
+  AddressList proxy_addresses_;
+
+  const HostPortPair proxy_;
+  const std::string username_;
+  const std::string password_;
+
+  // Where the caller believes it is connected; every datagram names it.
+  IPEndPoint destination_;
+  // Where datagrams are actually sent, as the proxy reported it.
+  IPEndPoint relay_;
+
+  State next_state_ = STATE_NONE;
+  CompletionOnceCallback user_callback_;
+  scoped_refptr<DrainableIOBuffer> write_buf_;
+  scoped_refptr<GrowableIOBuffer> read_buf_;
+  // Set while reading the variable-length part of the associate reply.
+  size_t associate_reply_remaining_ = 0;
+
+  NetworkTrafficAnnotationTag traffic_annotation_;
+  NetLogWithSource net_log_;
+  base::WeakPtrFactory<SOCKS5UDPClientSocket> weak_factory_{this};
+};
+
