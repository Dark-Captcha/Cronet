+scoped_refptr<DrainableIOBuffer> SOCKS5ClientSocket::BuildAuthWriteBuffer()
+    const {
+  // RFC 1929 section 2:
+  //     +----+------+----------+------+----------+
+  //     |VER | ULEN |  UNAME   | PLEN |  PASSWD  |
+  //     +----+------+----------+------+----------+
+  //     | 1  |  1   | 1 to 255 |  1   | 1 to 255 |
+  //     +----+------+----------+------+----------+
+  // VER is the subnegotiation's own version, 0x01, not the SOCKS version.
+  std::vector<uint8_t> request;
+  request.reserve(3 + username_.size() + password_.size());
+
+  request.push_back(kAuthSubnegotiationVersion);
+  request.push_back(base::checked_cast<uint8_t>(username_.size()));
+  request.insert(request.end(), username_.begin(), username_.end());
+  request.push_back(base::checked_cast<uint8_t>(password_.size()));
+  request.insert(request.end(), password_.begin(), password_.end());
+
+  auto base_buffer = base::MakeRefCounted<VectorIOBuffer>(std::move(request));
+  return base::MakeRefCounted<DrainableIOBuffer>(std::move(base_buffer),
+                                                 base_buffer->size());
+}
